# FinPanel Agent Engine — Environment Configuration
# Copy this to .env and fill in real values

# LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120

# Optional data source keys
FRED_API_KEY=
FINNHUB_API_KEY=

# Runtime
LOG_LEVEL=INFO
FIRM_NAME=FinPanel Virtual Capital
TIMEZONE=America/New_York

# Feature flags
ENABLE_CHROMADB=false
ENABLE_DEBATE=true
